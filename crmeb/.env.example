APP_DEBUG = true
SMS_DEBUG = true

[APP]
DEFAULT_TIMEZONE = Asia/Shanghai
# 随机字符串，生产环境务必修改。用于加密 API token 等
APP_KEY = crmeb

[DATABASE]
# 数据库类型：mysql / pgsql / sqlite / sqlsrv
TYPE = pgsql
HOSTNAME = 127.0.0.1
HOSTPORT = 5432
USERNAME = postgres
PASSWORD = 请改成实际数据库密码
DATABASE = crmeb
PREFIX = eb_
CHARSET = utf8
DEBUG = true

[LANG]
default_lang = zh-cn

[CACHE]
# file / redis
DRIVER = file
CACHE_PREFIX = crmeb
CACHE_TAG_PREFIX = tag:

[QUEUE]
QUEUE_NAME = CRMEB
# sync 同步执行；redis 需要配置 Redis 连接
DRIVER = sync
